user www-data;


# nb de processus de travail a lancer -> depend donc auto
worker_processes auto;


# chaque processus worker pourra gerer jusqu’a 1024 connexions en meme temps
events {
    worker_connections 1024;
}


http {


    # on charge la liste des types MIME (poru connaitre le type du fichier css, html...)


    include /etc/nginx/mime.types;
    default_type application/octet-stream;


    # pour ameliorer l’envoi des fichiers statiques
    sendfile on;


    # une connexion est gardee ouverte pendant 65 sec
    keepalive_timeout 65;


    # on definit un serveur web précis, ici https
    server {


        # NGINX ecoute sur port 443 en SSL/TLS en IPv4 (donc les visiteurs arrivent en https)
        listen 443 ssl;


        # pareil mais en IPv6
        listen [::]:443 ssl;


        #nom de dommaine attendu (ex login.42.fr)
        server_name ${DOMAIN_NAME};


        # on autorise seulement TLS 1.2 et TLS 1.3
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /etc/nginx/ssl/inception.crt;
        ssl_certificate_key /etc/nginx/ssl/inception.key;


        #on va chercher les fichiers du site dans ce dossier (endroit ou il y a le volume WP)
        root /var/www/html;
        index index.php index.html index.htm;


        # NGINX va chercher si le chemin est correxct, et envoie vers un vrai fichier
        # si oui il sert le fichier a wordpress (ou a PHP-FPM si le dossier cmprend un index.php)
        #si non il check si le dossier existe
        # si rien n'existe : renvoie interne vers /index.php?$args ==> c'est a WP d'interpreter tout seul
        location / {
            try_files $uri $uri/ /index.php?$args;
        }


        location ~ \.php$ {


            # charge les parametres FastCGI standards
            include /etc/nginx/fastcgi_params;


            # fait pour que les fichier .php soient envoye au service Wordpress sur le port 9000 
            fastcgi_pass wordpress:9000;


            # indique a PHP-FPM quel fichier PHP exact doit être execute
            # ex : si root = /var/www/html et qu’on demande /index.php  ==> /var/www/html/index.php
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
        }


        # bloque l’acces aux fichiers qui commencent par .ht
        location ~ /\.ht {
            deny all;
        }
    }
}


mon script de nginx :

#!/bin/bash
set -e


#   on cree le dossier pour stocker le certificat SSL s'il n'existe pas encore.
mkdir -p /etc/nginx/ssl


#   on genere un certificat SSL autosigne (-x509) , valable 365 jours avec une cle RSA 2048 bits
#   Certificat SSL ->  chiffrer la connexion navigateur <=> serveur
#   NGINX utilise la cle privée (inception.key) et le certificat (inception.crt) pr activer le https
#   securise l’acces a NGINX sur le port 443


openssl req -x509 -nodes -days 365 \
    -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/inception.key \
    -out /etc/nginx/ssl/inception.crt \
    -subj "/C=FR/ST=IDF/L=Paris/O=42/OU=42/CN=${DOMAIN_NAME}"


#   on demarre nginx comme processus principal,(PID 1)
#   "daemon off" = pas en arriere plan 
#   on remplace remplace ${DOMAIN_NAME} par le vrai nom de domaine car NGINX ne le remplace pas tout seul


sed "s|\${DOMAIN_NAME}|${DOMAIN_NAME}|g" /etc/nginx/nginx.conf > /tmp/nginx.conf
exec nginx -c /tmp/nginx.conf -g "daemon off;"


